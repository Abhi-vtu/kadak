# Kadak AirMenu backend — PRODUCTION environment TEMPLATE.
# On the server this becomes <deploy-path>/shared/backend.env
# (owner root:kadak, mode 640). Replace every YOUR_... value; deployment
# refuses to run while any remain. NEVER commit the filled-in file.
# Variable names match backend/.env.example.

# PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/DATABASE
#  - Amazon RDS: HOST is the RDS endpoint; set DATABASE_SSL=true.
#  - PostgreSQL on this same EC2 instance: HOST is 127.0.0.1; DATABASE_SSL=false.
# Percent-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME
DATABASE_SSL=true

# Manager dashboard password — long and random, e.g. `openssl rand -base64 24`.
MANAGER_PASSWORD=YOUR_LONG_RANDOM_MANAGER_PASSWORD

# Persistent photo storage, OUTSIDE the replaceable releases. Must stay this path.
UPLOAD_DIR=__DEPLOY_PATH__/shared/uploads

APP_TZ=Asia/Kolkata

# Backend listens here; Nginx proxies to it (deploy/nginx/kadak.conf.template).
# Do NOT open this port in the security group.
PORT=4000
