# ---- Kadak AirMenu backend env ----
# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://kadak:kadak@localhost:5432/kadak
# Set to true only if your Postgres host requires SSL (most hosted providers do).
DATABASE_SSL=false

# Manager dashboard password (choose something long & private)
MANAGER_PASSWORD=change-me-please

# Where uploaded item photos are saved (relative to backend/, or an absolute path)
UPLOAD_DIR=uploads

# Timezone used for "today" in analytics
APP_TZ=Asia/Kolkata

# Port
PORT=4000
